@startuml
'https://plantuml.com/class-diagram

title Update Airport Status: Architecture — Class Diagram

package "Domain Layer (Airport Aggregate)" {
    class Airport <<root>> <<entity>> {
        - name : String
        - iataCode : LocationIdentifier
        - airportType : AirportType
        - coordinates : Coordinates
        - airportLocation : AirportLocation
        - timeZone : TimeZone
        - operationalHours : OperationalHours
        - status : AirportStatus
        ---
        + updateStatus(newStatus : AirportStatus)
    }

    interface AirportRepository {
        ---
        + findByIataCode(iataCode : LocationIdentifier) : Optional<Airport>
        + save(airport : Airport) : Airport
    }

    class UpdateAirportService <<Domain Service>> {
        ---
        + changeAirportStatus(iataCode : LocationIdentifier, newStatus : AirportStatus) : Airport
    }
}

UpdateAirportService ..> AirportRepository : uses >
UpdateAirportService ..> Airport : updates >

@enduml