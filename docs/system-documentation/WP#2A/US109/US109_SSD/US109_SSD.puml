@startuml
autonumber
title Update Airport Status — System Sequence Diagram

autoactivate on

actor "BO" as BO
participant ":System" as Sys

BO -> Sys : PATCH /airports/{iataCode}/status\n{ "status": "CLOSED" }

alt User has authorization

    alt The airport exists in the system
        Sys --> BO : 200 OK\n{ iataCode, name, status: "CLOSED", ... }

    else The airport does not exist
        Sys --> BO : 404 Not Found\n{ message: "Airport not found" }
    end

else User does not have authorization
    Sys --> BO : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml