@startuml
autonumber
title US206 - Calculate Total Operational Hours — Sequence Diagram

autoactivate on

actor "ATCC" as ATCC
participant "AircraftController" as Ctrl
participant "CalculateOpHoursUseCase" as UC
participant "CalculateOpHoursService" as Service
database "AircraftRepository" as Repo

ATCC -> Ctrl : GET /aircrafts/operational-hours

Ctrl -> Ctrl : extract username & roles from JWT
alt User has authorization (Role: ATCC)
    Ctrl -> UC : execute()

    UC -> Service : calculateFleetOperationalHours()

    Service -> Repo : findFleetOperationalHours()
    return opHoursList

    Service --> UC : return opHoursList
    UC --> Ctrl : return opHoursList

    Ctrl --> ATCC : 200 OK\n[ { registrationId, operationHours }, ... ]

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml