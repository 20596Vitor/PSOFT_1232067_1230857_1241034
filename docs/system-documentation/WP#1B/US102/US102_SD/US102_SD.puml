@startuml
autonumber
title US102 - Register an Aircraft Instance — Sequence Diagram

autoactivate on

actor "Air Transport Company Collaborator" as ATCC
participant "AircraftController" as Ctrl
participant "RegisterAircraftUseCase" as UC
participant "RegisterAircraftService" as Service
database "AircraftModelRepository" as ModelRepo
database "AircraftRepository" as Repo

ATCC -> Ctrl : POST /aircrafts\n{ registrationNumber, modelName, seatingCapacity, manufacturingDate, status }

Ctrl -> Ctrl : extract username from JWT
alt User has authorization
    Ctrl -> UC : execute(registrationNumber, modelName, seatingCapacity, manufacturingDate, status)

    UC -> Service : registerAircraft(registrationNumber, modelName, seatingCapacity, manufacturingDate, status)

    Service -> Repo : existsById(registrationNumber)
    return exists

    alt The Aircraft Registration Number already exists
        Service --> UC : throw IllegalArgumentException("Aircraft already exists")
        UC --> Ctrl : throw ResponseStatusException(409, "Conflict")
        Ctrl --> ATCC : 409 Conflict\n{ message: "Aircraft registration number already registered" }

    else The Aircraft Registration Number does NOT exist

        Service -> ModelRepo : findByModelName(modelName)
        return oModel

        alt Model does not exist
            Service --> UC : throw EntityNotFoundException("Model not found")
            UC --> Ctrl : throw ResponseStatusException(404, "Not Found")
            Ctrl --> ATCC : 404 Not Found\n{ message: "Specified aircraft model does not exist" }

        else Model exists

            alt seatingCapacity > model.getMaxSeatingCapacity()
                Service --> UC : throw IllegalArgumentException("Capacity exceeds model limit")
                UC --> Ctrl : throw ResponseStatusException(400, "Bad Request")
                Ctrl --> ATCC : 400 Bad Request\n{ message: "Seating capacity exceeds the model's maximum limit" }

            else Capacity is valid
                Service -> Aircraft ** : new Aircraft(registrationNumber, model, manufacturingDate, seatingCapacity, status)

                Service -> Repo : save(aircraft)
                return aircraft(persisted)

                return aircraft
                return 201 Created\n{ registrationNumber, modelName, seatingCapacity, _links }
            end
        end
    end

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml