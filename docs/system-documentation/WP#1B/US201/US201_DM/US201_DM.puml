@startuml
title US201 - Update Aircraft Model Specifications - Domain Model

package "Aircraft Aggregate" {
    class AircraftModel <<root>> <<entity>> {
        - manufacturer: String
        - model_name: String
    }

    class CruisingSpeed <<value object>> {
        - speed: float
    }

    class FuelCapacity <<value object>> {
        - capacity: float
    }

    class MaxRange <<value object>> {
        - range: float
    }

    class SeatingCapacity <<value object>> {
        - capacity: int
    }

    AircraftModel o--> "1" CruisingSpeed
    AircraftModel o--> "1" FuelCapacity
    AircraftModel o--> "1" MaxRange
    AircraftModel o--> "1" SeatingCapacity
}
@enduml