@startuml
autonumber
title US203 - View Compatible Routes — Sequence Diagram

autoactivate on

actor "ATCC" as ATCC
participant "AircraftController" as Ctrl
participant "ViewCompatibleRoutesUseCase" as UC
participant "ViewCompatibleRoutesService" as Service
database "AircraftRepository" as AircraftRepo
database "RouteRepository" as RouteRepo

ATCC -> Ctrl : GET /aircrafts/{registrationNumber}/compatible-routes

Ctrl -> Ctrl : extract username & roles from JWT
alt User has authorization (Role: ATCC)
    Ctrl -> UC : execute(registrationNumber)

    UC -> Service : getCompatibleRoutes(registrationNumber)

    Service -> AircraftRepo : findById(registrationNumber)
    return optAircraft

    alt Aircraft is NOT found
        Service --> UC : throw EntityNotFoundException("Aircraft not found")
        UC --> Ctrl : throw ResponseStatusException(404, "Not Found")
        Ctrl --> ATCC : 404 Not Found\n{ message: "Aircraft with the specified registration number does not exist" }

    else Aircraft is found
        Service -> AircraftRepo : aircraft = get()
        return

        Service -> RouteRepo : findCompatibleRoutes(aircraft.getRange(), aircraft.getSeatingCapacity())
        return routesList

        Service --> UC : return routesList
        UC --> Ctrl : return routesList

        Ctrl --> ATCC : 200 OK\n[ { routeId, minRange, minCapacity... }, ... ]
    end

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml