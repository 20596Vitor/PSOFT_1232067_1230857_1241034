@startuml
autonumber
title US205 - View Real-Time Aircraft Availability — Sequence Diagram

autoactivate on

actor "ATCC" as ATCC
participant "AircraftController" as Ctrl
participant "ViewAvailabilityUseCase" as UC
participant "ViewAvailabilityService" as Service
database "AircraftRepository" as Repo

ATCC -> Ctrl : GET /aircrafts/availability

Ctrl -> Ctrl : extract username & roles from JWT
alt User has authorization (Role: ATCC)
    Ctrl -> UC : execute()

    UC -> Service : getFleetAvailability()

    Service -> Repo : findFleetAvailability()
    return availabilityList

    Service --> UC : return availabilityList
    UC --> Ctrl : return availabilityList

    Ctrl --> ATCC : 200 OK\n[ { registrationId, modelName, status }, ... ]

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml