@startuml
autonumber
title US104 - Search for Aircraft — Sequence Diagram

autoactivate on

actor "ATCC" as ATCC
participant "AircraftController" as Ctrl
participant "SearchAircraftUseCase" as UC
participant "SearchAircraftService" as Service
database "AircraftRepository" as Repo

ATCC -> Ctrl : GET /aircrafts?model={model}&status={status}&year={year}

Ctrl -> Ctrl : extract username & roles from JWT
alt User has authorization (Role: ATCC)
    Ctrl -> UC : execute(model, status, year)

    UC -> Service : searchAircrafts(model, status, year)

    Service -> Repo : findByCriteria(model, status, year)
    return aircraftList

    Service --> UC : return aircraftList
    UC --> Ctrl : return aircraftList

    Ctrl --> ATCC : 200 OK\n[ { registrationNumber, modelName, status, year... }, ... ]

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml