@startuml
autonumber
title US105 - Update Aircraft Status — Sequence Diagram

autoactivate on

actor "ATCC" as ATCC
participant "AircraftController" as Ctrl
participant "UpdateAircraftStatusUseCase" as UC
participant "UpdateAircraftStatusService" as Service
database "AircraftRepository" as Repo

ATCC -> Ctrl : PATCH /aircrafts/{registrationNumber}/status\n{ status }

Ctrl -> Ctrl : extract username & roles from JWT
alt User has authorization (Role: ATCC)
    Ctrl -> UC : execute(registrationNumber, status)

    UC -> Service : updateStatus(registrationNumber, status)

    Service -> Repo : findById(registrationNumber)
    return optAircraft

    alt Aircraft is NOT found
        Service --> UC : throw EntityNotFoundException("Aircraft not found")
        UC --> Ctrl : throw ResponseStatusException(404, "Not Found")
        Ctrl --> ATCC : 404 Not Found\n{ message: "Aircraft with the specified registration number does not exist" }

    else Aircraft is found

        Service -> Aircraft : updateStatus(status)
        note right: Business logic: verify if state transition is allowed
        return

        Service -> Repo : save(aircraft)
        return aircraft(persisted)

        Service --> UC : return aircraft
        UC --> Ctrl : return aircraft

        Ctrl --> ATCC : 200 OK\n{ registrationNumber, status, _links }
    end

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml