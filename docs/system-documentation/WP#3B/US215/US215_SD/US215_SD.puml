@startuml
autonumber
title US215 - Calculate Total Route Distance — Sequence Diagram

autoactivate on

actor "ATCC" as Actor
participant "RouteController" as Ctrl
participant "CalculateTotalDistanceUseCase" as UC
participant "RouteService" as Service
participant "DistanceCalculator" as Calc
database "RouteRepository" as RouteRepo

Actor -> Ctrl : GET /routes/total-distance

Ctrl -> Ctrl : extract username and role from JWT
alt User has authorization (ATCC Role)
    Ctrl -> UC : execute()

    UC -> Service : calculateTotalNetworkDistance()

    Service -> RouteRepo : findAllActiveRoutes()
    return routesList

    Service -> Service : initialize totalDistance = 0.0

    loop for each Route in routesList
        Service -> Calc : calculateDistance(route.origin.coordinates, route.destination.coordinates)
        return distance

        Service -> Service : totalDistance += distance
    end

    return totalDistance

    Ctrl -> Ctrl : map to DTO and add HATEOAS links
    return 200 OK\n{ total_distance: value, unit: "km", _links }

else User does not have authorization
    Ctrl --> Actor : 403 Forbidden\n{ message: "Not authorized" }
end

@enduml