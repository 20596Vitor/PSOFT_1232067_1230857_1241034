@startuml
autonumber
title US113.2 - View Route Details by ID — Sequence Diagram

autoactivate on

actor "ATCC" as Actor
participant "RouteController" as Ctrl
participant "ViewRouteDetailsUseCase" as UC
participant "ViewRouteService" as Service
database "RouteRepository" as Repo

Actor -> Ctrl : GET /routes/{routeId}

Ctrl -> Ctrl : extract username and role from JWT
alt User has authorization (ATCC Role)
    Ctrl -> UC : executeGetById(routeId)

    UC -> Service : getRouteDetails(routeId)

    Service -> Repo : findById(routeId)
    return Optional<Route>

    alt Route exists
        Service --> UC : route
        UC --> Ctrl : route
        Ctrl --> Actor : 200 OK\n{ routeId, origin, destination, estimatedTime, ..., _links }
    else Route does NOT exist
        Service --> UC : throw IllegalArgumentException("Route not found")
        UC --> Ctrl : throw ResponseStatusException(404, "Not Found")
        Ctrl --> Actor : 404 Not Found\n{ message: "Route not found" }
    end

else User does not have authorization
    Ctrl --> Actor : 403 Forbidden\n{ message: "Not authorized" }
end

@enduml