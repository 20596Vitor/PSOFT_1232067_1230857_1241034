@startuml
autonumber
title US211 - Group Airports by Country — Sequence Diagram

autoactivate on

actor "Air Transport Company Collaborator" as ATCC
participant "AirportController" as Ctrl
participant "FindAirportsGroupedUseCase" as UC
participant "EnhancedAirportService" as Service
database "AirportRepository" as Repo

ATCC -> Ctrl : GET /api/airports/search/grouped?country=Portugal

Ctrl -> Ctrl : extract username and role from JWT
alt User has "ATCC" authorization
    Ctrl -> UC : execute(country)

    UC -> Service : getAirportsByCountry(country)

    Service -> Repo : findByCountry(country)
    return listOfAirports

    return listOfAirports
    return 200 OK\n[ { iataCode, name, city, country, _links }, ... ]

else User does not have authorization
    Ctrl --> ATCC : 403 Forbidden\n{ message: "Not authorized to perform this action" }
end

@enduml