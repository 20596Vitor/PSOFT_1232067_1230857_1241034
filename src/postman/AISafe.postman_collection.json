  "item": [
    {
      "name": "Login sucesso admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 200 OK - Autenticado\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Retornou o Role correto de ADMIN\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.role).to.eql(\"ADMIN\");",
              "});",
              "",
              "pm.test(\"Retornou mensagem de sucesso\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.mensagem).to.include(\"sucesso\");",
              "});",
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"jwt_token\", jsonData.token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "auth", "login"]
        }
      }
    },
