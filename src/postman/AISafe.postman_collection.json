    {
      "name": "Inserir aeroporto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 201 Created\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([201, 211]);",
              "});",
              "",
              "pm.test(\"Aeroporto criado tem o código IATA correto\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.iataCode).to.eql(\"MAD\");",
              "});",
              "",
              "pm.test(\"Estado inicial é OPERATIONAL\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"OPERATIONAL\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"iataCode\": \"MAD\",\n    \"name\": \"Aeroporto Adolfo Suárez Madrid-Barajas\",\n    \"city\": \"Madrid\",\n    \"country\": \"Espanha\",\n    \"type\": \"comercial\"\n}",
          "options": {
            "raw": {
