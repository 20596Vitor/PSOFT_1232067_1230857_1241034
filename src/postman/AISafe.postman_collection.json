    {
      "name": "US102 - Registar Aeronave",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Matrícula associada corretamente\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.registrationNumber).to.eql(\"CS-TKA\");",
              "});",
              "",
              "pm.test(\"Estado inicial é ACTIVE\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(\"ACTIVE\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"registrationNumber\": \"CS-TKA\",\n  \"manufacturingDate\": \"2023-01-15\",\n  \"seatingCapacity\": 189,\n  \"status\": \"ACTIVE\",\n  \"modelId\": 1\n}"
