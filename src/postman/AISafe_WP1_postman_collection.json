  "item": [
    {
      "name": "US101 - Registar Modelo de Aeronave",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code é 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"O modelo foi criado com sucesso\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.modelName).to.eql(\"737 MAX 8\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"manufacturer\": \"Boeing\",\n  \"modelName\": \"737 MAX 8\",\n  \"cruisingSpeed\": 839.0,\n  \"fuelCapacity\": 25941.0,\n  \"maxRange\": 6570.0\n}"
        },
        "url": {
